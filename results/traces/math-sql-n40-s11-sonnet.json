          "input": {
            "sql": "with m as (select * from matters where status='Open' and practice_area='Litigation'),\nd as (select distinct matter_id from docket_entries where deadline_date between date '2026-09-15' and date '2026-10-06'),\nem as (select distinct m.matter_id, p.role from m join client_contacts c on c.client_id=m.client_id join email_participants p on lower(trim(p.email))=lower(trim(c.email)) join emails e on e.message_id=p.message_id where e.received_date between date '2026-09-01' and date '2026-09-15'),\nt as (select matter_id, sum(case when date>=date '2026-09-01' and date<=date '2026-09-15' and not non_billable then hours else 0 end) h,\n sum(case when date<date '2026-09-01' and not non_billable and not billed then total else 0 end) u from time_entries group by matter_id)\nselect m.display_number, m.responsible_attorney, coalesce(t.h,0) h, coalesce(t.u,0) u, (select string_agg(role) from em where em.matter_id=m.matter_id) roles\nfrom m join d using(matter_id) left join t using(matter_id)\norder by 2,1"
