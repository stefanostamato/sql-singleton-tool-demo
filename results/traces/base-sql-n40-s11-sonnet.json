          "name": "sql_query",
          "input": {
            "sql": "with m as (select * from matters where status='Open' and practice_area='Litigation' and exists(select 1 from docket_entries d where d.matter_id=matters.matter_id and deadline_date between date '2026-09-15' and date '2026-10-06'))\nselect m.display_number, m.responsible_attorney,\n(select count(*) from email_participants p join emails e using(message_id) join client_contacts c on lower(trim(c.email))=lower(trim(p.email)) where c.client_id=m.client_id and e.received_date between date '2026-09-01' and date '2026-09-15' and p.role in('from','to')) em_to_from,\n(select count(*) from email_participants p join emails e using(message_id) join client_contacts c on lower(trim(c.email))=lower(trim(p.email)) where c.client_id=m.client_id and e.received_date between date '2026-09-01' and date '2026-09-15') em_all,\n(select count(*) from time_entries t where t.matter_id=m.matter_id and t.date between date '2026-09-01' and date '2026-09-15' and not t.non_billable) tm\nfrom m order by 2,1"
          },
