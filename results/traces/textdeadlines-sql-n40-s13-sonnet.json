          "input": {
            "sql": "with c as (select unnest(['0001','0003','0005','0006','0007','0009','0010','0011','0012','0013','0016','0017','0018','0020','0021','0022','0025','0027','0030','0034','0035','0036','0037','0038','0039']) n)\nselect m.display_number, m.responsible_attorney from matters m join c on m.display_number='HV-2026-'||c.n\nwhere m.status='Open' and m.practice_area='Litigation'\nand not exists (select 1 from email_participants p join client_contacts cc on lower(cc.email)=lower(p.email) join emails e on e.message_id=p.message_id where cc.matter_id=m.matter_id and e.received_date between date '2026-09-01' and date '2026-09-15')\nand not exists (select 1 from time_entries t where t.matter_id=m.matter_id and t.date between date '2026-09-01' and date '2026-09-15' and not t.non_billable)\norder by 2,1"
          },
