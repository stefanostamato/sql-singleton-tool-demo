          "input": {
            "sql": "select m.display_number, m.responsible_attorney from matters m\nwhere status='Open' and practice_area='Litigation'\nand exists(select 1 from docket_entries d where d.matter_id=m.matter_id and d.deadline_date between date '2026-09-15' and date '2026-10-06')\nand not exists(select 1 from client_contacts c join email_participants p on lower(trim(p.email))=lower(trim(c.email)) join emails e on e.message_id=p.message_id where c.client_id=m.client_id and e.received_date between date '2026-09-01' and date '2026-09-15')\nand not exists(select 1 from time_entries t where t.matter_id=m.matter_id and t.date between date '2026-09-01' and date '2026-09-15' and not t.non_billable)\norder by 2,1"
          },
